# --- LLM verdict engine (optional: without a key the app runs the deterministic local engine) ---
# Get a free key at https://openrouter.ai/keys  (any OpenAI-compatible endpoint works)
OPENROUTER_API_KEY=
# Optional overrides
VERDICT_MODEL=openrouter/free
# auto = use LLM when a key is present, otherwise local | llm | local
VERDICT_MODE=auto
# OpenAI-compatible base URL (defaults to https://openrouter.ai/api/v1)
OPENAI_BASE_URL=

# --- Chain data (safe defaults; no key required) ---
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
BLOCKSCOUT_API=https://base-sepolia.blockscout.com
NEXT_PUBLIC_CHAIN=baseSepolia
